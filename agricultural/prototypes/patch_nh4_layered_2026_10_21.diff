+def nh4_rescale(vec, total):
+    """Make the per-layer ammonium list sum to `total` after a scalar-only change (proportional, or all into layer 1 if it was empty)."""
+    cur = sum(vec)
+    if cur > 1e-12:
+        f = total / cur
+        for i in range(len(vec)):
+            vec[i] *= f
+    else:
+        for i in range(len(vec)):
+            vec[i] = 0.0
+        vec[0] = total
+
+
+def nh4_apply_netmin(nh4_layers, no3_layers, nm_layers):
+    """Per-layer net mineralization: positive into the layer's NH4; negative (immobilization) from the layer's own NH4 then its own nitrate."""
+    for i, v in enumerate(nm_layers[:len(nh4_layers)]):
+        if v >= 0.0:
+            nh4_layers[i] += v
+            continue
+        need = -v
+        t = min(nh4_layers[i], need); nh4_layers[i] -= t; need -= t
+        if need > 0.0 and IMMOB_FROM_NO3 and no3_layers is not None:
+            t = min(no3_layers[i], need); no3_layers[i] -= t; need -= t
+        if need > 1e-12 and N_UNMET is not None:
+            N_UNMET.append((_DIAG_YEAR, _DIAG_CTX.get("doy"), need))
+
+
+def nh4_nitrify_volatilize(nh4_layers, no3_layers, layers, sixpool_state, tsoil_lag, wind, model_volatilization, ph=None):
+    """One day of per-layer nitrification (layer start-of-day NH4 and NO3, layer temperature and saturation) and surface volatilization. Mutates the lists;
+    returns (nitrified total, volatilized, n2o from nitrification)."""
+    tl = sixpool_state.get("t_layers") if sixpool_state is not None else None
+    nit_tot = 0.0; n2o = 0.0
+    nits = []
+    for i in range(len(nh4_layers)):
+        T = (tl[i] if (tl is not None and len(tl) > i and not (i == 0 and NH4_LAYER_TEMP == "lag0")) else tsoil_lag)
+        nits.append(nitrification_flux_ratio(nh4_layers[i], no3_layers[i], T, layers[i]["theta"] / layers[i]["sat"]))
+    vol = volatilization_flux(tsoil_lag, nh4_layers[0], layers[0], wind, ph) if model_volatilization else 0.0
+    for i, nit in enumerate(nits):
+        nh4_layers[i] = max(0.0, nh4_layers[i] - nit - (vol if i == 0 else 0.0))
+        no3_layers[i] += nit
+        n2o += n2o_from_nitrification(nit, layers[i]["theta"] / layers[i]["sat"])
+        nit_tot += nit
+    return nit_tot, vol, n2o
+
