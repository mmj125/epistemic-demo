+NH4_LAYERED = True   # ammonium tracked per layer (Cycles' N process arrays are per layer, SI of Cycles-L): mineralization lands in the layer where it happens, every layer nitrifies with the same law
+NH4_ROOT_ACCESS = True   # ammonium uptake limited to layers the roots have reached (False: all ammonium reachable, as the lumped pool was)
+NH4_LAYER_TEMP = "hc"   # layer temperature for nitrification: "hc" = heat-conduction layer temperatures, "lag0" = lagged air temperature in layer 1 and hc below
+
